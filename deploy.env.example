# hPanel > Fichiers > Comptes FTP
# IP FTP affichée par hPanel. Le nom ftp.<domaine> marche aussi, mais aucun des
# deux n'est couvert par le certificat TLS de Hostinger (*.hstgr.io).
FTP_HOST=213.130.145.253
# Nom sous lequel vérifier le certificat (*.hstgr.io), en se connectant à FTP_HOST.
FTP_TLS_NAME=ftp.hstgr.io
FTP_USER=u000000000
FTP_PASS=
# Racine web du domaine. Domaine principal : public_html
# Domaine additionnel : public_html/quipaie2027.fr
FTP_DIR=public_html
